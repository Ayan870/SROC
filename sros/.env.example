# Environment Settings
ENV=development
DEBUG=true
PROJECT_NAME="SROS API"

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=sros_db

# SQLAlchemy Database Connection URL (Asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@db:5432/sros_db
# For local running without docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/sros_db

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Frontend Next.js settings
NEXT_PUBLIC_API_URL=http://localhost:8000
